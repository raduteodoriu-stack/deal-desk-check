      ],
      "academic_eligible": true,
      "aliases": [
        "Premium support"
      ]
    },
    {
      "id": "P-09",
      "sku": "SVC-ONB",
      "name": "Onboarding package",
      "line_type": "one_off",
      "family": "services",
      "unit": "package",
      "list_price": "8000.00",
      "academic_eligible": false,
      "aliases": [
        "Onboarding",
