{
  "rules_version": "1.1",
  "status": "proposed",
  "company": "MoP Cloud (fictional)",
  "currency": "EUR",
  "note": "Fictional prices. Structure modelled on Seqera's public pricing (platform plans + committed compute credits + overage).",
  "business_hours": {
    "timezone": "Europe/Madrid",
    "days": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri"
    ],
    "start": "09:00",
    "end": "18:00",
    "holidays": "ES national"
  },
  "standard_terms": {
    "term_months_allowed": [
      12,
      24,
      36
    ],
    "billing_frequency": [
      "annual_in_advance",
      "multi_year_upfront"
    ],
    "payment_terms_days": 30,
    "auto_renewal": true,
    "non_renewal_notice_days": 60,
    "renewal_uplift_cap_pct_max": 7,
    "opt_out": false,
    "credit_rollover_pct": 0,
    "liability_cap_months": 12,
    "governing_law": "Spain",
    "quote_validity_days": 30
  },
  "price_book": [
    {
      "id": "P-01",
      "sku": "PLT-PRO",
      "name": "Cloud Pro platform",
      "line_type": "recurring",
      "family": "platform",
      "unit": "year",
      "list_price": "12000.00",
      "included_users": 10,
      "max_total_users": 50,
      "academic_eligible": true,
      "aliases": [
